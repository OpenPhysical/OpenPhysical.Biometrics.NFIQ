<Project>
    <PropertyGroup>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RunAnalyzers>true</RunAnalyzers>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'"
            >true</ContinuousIntegrationBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <!-- Package 1.3.0 otherwise selects its net9 tool on a net10 SDK. -->
        <CSharpier_FrameworkVersion>net10.0</CSharpier_FrameworkVersion>
        <CSharpier_Bypass
            Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)artifacts'))"
            >true</CSharpier_Bypass>
        <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts/bin/$(MSBuildProjectName)/</BaseOutputPath>
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
        <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages/</PackageOutputPath>
        <Authors>OpenPhysical Contributors</Authors>
        <Company>OpenPhysical</Company>
        <Copyright>Copyright © 2026 Mistial Developer</Copyright>
        <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/OpenPhysical/OpenPhysical.Biometrics.NFIQ</PackageProjectUrl>
        <RepositoryUrl>https://github.com/OpenPhysical/OpenPhysical.Biometrics.NFIQ.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Version>1.0.0</Version>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="CSharpier.MsBuild" Version="1.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="StyleCop.Analyzers" Version="1.3.151-beta" PrivateAssets="all" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" />
    </ItemGroup>
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" />
        <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="/" />
        <None
            Include="$(MSBuildThisFileDirectory)COMMERCIAL-LICENSING.md"
            Pack="true"
            PackagePath="/"
        />
        <None
            Include="$(MSBuildThisFileDirectory)THIRD_PARTY_NOTICES.md"
            Pack="true"
            PackagePath="/"
        />
    </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>
    <ItemGroup>
        <None
            Include="../../runtimes.props"
            Link="runtimes.props"
            CopyToOutputDirectory="PreserveNewest"
        />
        <PackageReference Include="coverlet.collector" Version="6.0.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="NUnit" Version="4.3.2" />
        <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
        <ProjectReference Include="../../src/OpenPhysical.Biometrics.NFIQ1/OpenPhysical.Biometrics.NFIQ1.csproj" />
        <ProjectReference Include="../../src/OpenPhysical.Biometrics.NFIQ2/OpenPhysical.Biometrics.NFIQ2.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None
            Include="../fixtures/**/*.gray8"
            Link="fixtures/%(RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
</Project>
